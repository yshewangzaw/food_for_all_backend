# Base URL of the Express backend. No trailing slash.
# The backend mounts every router under /api (see backend src/app.js).
VITE_API_BASE_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# TEST MODE — fake authentication
# ---------------------------------------------------------------------------
# true  = sign-in is faked. Any email/password works, and a "Skip sign-in"
#         button appears on the login page. Use this to reach the dashboard
#         while the backend can't run. A banner shows on every page.
# false = the real POST /api/auth/login is used.
#
# This fakes the LOGIN only, not your data — see src/services/fakeAuth.js.
# Set this to false before deploying.
VITE_USE_FAKE_AUTH=false
